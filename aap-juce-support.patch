diff --git a/src/headless/tests/DSPMemoryReleaseTest.cpp b/src/headless/tests/DSPMemoryReleaseTest.cpp
new file mode 100644
--- /dev/null
+++ b/src/headless/tests/DSPMemoryReleaseTest.cpp
@@ -0,0 +1,119 @@
+#include "UnitTests.h"
+#include "processors/tone/amp_irs/AmpIRs.h"
+#include "processors/chain/ProcessorChainStateHelper.h"
+
+#if JUCE_MAC
+#include <malloc/malloc.h>
+#endif
+
+class DSPMemoryReleaseTest : public UnitTest
+{
+public:
+    DSPMemoryReleaseTest() : UnitTest ("DSP Memory Release Test") {}
+
+    void runTest() override
+    {
+        PlayheadHelpers playhead;
+        for (const auto& name : { "Amp IRs", "LoFi IRs", "Chorus", "Flanger", "Rotary", "Delay", "Bass Face", "Metal Face" })
+        {
+            beginTest (String { name } + " releases DSP memory while retained for undo");
+            auto proc = ProcessorStore::getStoreMap().at (name).factory (nullptr);
+            proc->playheadHelpers = &playhead;
+            if (String { name } == "Amp IRs")
+            {
+                auto* ir = proc->getVTS().getParameter ("ir");
+                ir->setValueNotifyingHost (ir->convertTo0to1 (3.0f));
+            }
+
+            for (int cycle = 0; cycle < 3; ++cycle)
+            {
+                proc->prepareProcessing (48000.0, 512);
+                Thread::sleep (100); // let convolution jobs finish before measuring
+                const auto state = proc->toXML();
+#if JUCE_MAC
+                malloc_statistics_t before {};
+                malloc_zone_statistics (nullptr, &before);
+#endif
+                proc->freeInternalMemory();
+                Thread::sleep (100);
+#if JUCE_MAC
+                malloc_statistics_t after {};
+                malloc_zone_statistics (nullptr, &after);
+                // Measure live allocations, rather than pages cached by the allocator.
+                const auto minimumReleased = String { name } == "LoFi IRs" ? 1024u : 128 * 1024u;
+                expect (before.size_in_use > after.size_in_use + minimumReleased,
+                        "Retained processor must release its convolution/delay allocation");
+#endif
+                expect (state->isEquivalentTo (proc->toXML().get(), true), "Undo state must survive releasing DSP memory");
+                proc->freeInternalMemory(); // cleanup must also be safe when already released
+                proc->prepareProcessing (48000.0, 512); // undo/redo recreates the engine
+                AudioBuffer<float> buffer { 2, 512 };
+                for (int block = 0; block < 4; ++block)
+                {
+                    buffer.clear();
+                    buffer.setSample (0, 0, 1.0f);
+                    buffer.setSample (1, 0, 1.0f);
+                    proc->processAudioBlock (buffer);
+                    expect (chowdsp::BufferMath::sanitizeBuffer<AudioBuffer<float>, float> (buffer));
+                }
+                proc->freeInternalMemory();
+            }
+        }
+
+#if JUCE_MAC
+        beginTest ("Preset undo/redo rebuilds released DSP engines");
+        for (const auto& name : { "Bass Face", "Chopped Flange", "Mixed In Modulation" })
+        {
+            BYOD plugin;
+            plugin.prepareToPlay (48000.0, 512);
+            int index = -1;
+            for (int i = 0; i < plugin.getNumPrograms(); ++i)
+                if (plugin.getProgramName (i) == name)
+                    index = i;
+            expect (index >= 0, String { "Missing factory preset: " } + name);
+            if (index < 0)
+                continue;
+
+            plugin.setCurrentProgram (index);
+            MessageManager::getInstance()->runDispatchLoopUntil (100);
+            const auto state = plugin.getProcChain().getStateHelper().saveProcChain (true);
+            plugin.setCurrentProgram (0);
+            MessageManager::getInstance()->runDispatchLoopUntil (100);
+            expect (plugin.getUndoManager().undo());
+            const auto restoredState = plugin.getProcChain().getStateHelper().saveProcChain (true);
+            // I/O node positions are not undoable in BYOD; compare DSP state and routing.
+            for (auto* chainState : { state.get(), restoredState.get() })
+                for (const auto& ioName : { "Input", "Output" })
+                    if (auto* io = chainState->getChildByName (ioName))
+                        if (auto* parameters = io->getChildByName ("Parameters"))
+                        {
+                            parameters->removeAttribute ("x_pos");
+                            parameters->removeAttribute ("y_pos");
+                        }
+            expect (state->isEquivalentTo (restoredState.get(), true));
+            AudioBuffer<float> buffer { 2, 512 };
+            buffer.clear();
+            buffer.setSample (0, 0, 1.0f);
+            buffer.setSample (1, 0, 1.0f);
+            MidiBuffer midi;
+            plugin.processBlock (buffer, midi);
+            expect (chowdsp::BufferMath::sanitizeBuffer<AudioBuffer<float>, float> (buffer));
+            expect (plugin.getUndoManager().redo());
+            expectEquals (plugin.getProcChain().getProcessors().size(), 0);
+        }
+#endif
+
+        beginTest ("Custom Amp IR survives release and reprepare");
+        AmpIRs irs;
+        const auto irFile = File { BYOD_ROOT_DIR }.getChildFile ("src/headless/tests/test_ir.wav");
+        irs.loadIRFromStream (irFile.createInputStream());
+        irs.prepareProcessing (48000.0, 512);
+        const auto state = irs.toXML();
+        irs.freeInternalMemory();
+        irs.prepareProcessing (48000.0, 512);
+        expect (state->isEquivalentTo (irs.toXML().get(), true));
+        irs.freeInternalMemory();
+    }
+};
+
+static DSPMemoryReleaseTest dspMemoryReleaseTest;

